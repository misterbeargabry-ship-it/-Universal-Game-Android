name: Build Android APK

on:
  push:
    branches: [ "main" ]
  workflow_dispatch:

jobs:
  build-apk:
    runs-on: ubuntu-latest

    steps:
      - name: Scarica il codice del repository
        uses: actions/checkout@v4

      - name: Configura JDK 17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'

      - name: Configura Android SDK
        uses: android-actions/setup-android@v3

      - name: Dai permessi di esecuzione a Gradle
        run: chmod +x ./gradlew

      - name: Compila Debug APK
        run: ./gradlew assembleDebug

      - name: Carica l'APK come Artifact
        uses: actions/upload-artifact@v4
        with:
          name: Universal-Game-Android-v0.3-debug
          path: app/build/outputs/apk/debug/*.apk
